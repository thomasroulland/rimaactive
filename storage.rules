rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Connecté avec un rôle donné par Marie (l'API) : un compte créé autrement n'a pas de rôle et n'a accès à rien.
    function connecte() {
      return request.auth != null && request.auth.token.get('role', '') in ['client', 'coach'];
    }
    function estCoach() {
      return connecte() && request.auth.token.role == 'coach';
    }
    // Le client propriétaire du dossier, ou le coach.
    function clientOuCoach(uid) {
      return (connecte() && request.auth.token.role == 'client' && request.auth.uid == uid) || estCoach();
    }
    // Photo déjà réduite dans le navigateur : JPEG, PNG ou WebP, 5 Mo maximum.
    function photoValide() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    // Photos des exercices : lues par tout client ou coach, écrites par le coach.
    match /exercices/{exoId}/{fichier=**} {
      allow read: if connecte();
      allow create, update: if estCoach() && photoValide();
      allow delete: if estCoach();
    }

    // Photos d'un client : le client concerné et le coach.
    match /clients/{uid}/{fichier=**} {
      allow read: if clientOuCoach(uid);
      allow create, update: if clientOuCoach(uid) && photoValide();
      allow delete: if clientOuCoach(uid);
    }

    // PDF joints aux bilans : le coach seulement (PDF, 10 Mo au plus).
    match /bilans/{uid}/{fichier=**} {
      allow read, delete: if estCoach();
      allow create, update: if estCoach() && request.resource != null
        && request.resource.contentType == 'application/pdf'
        && request.resource.size <= 10 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
