# Variables publiques Firebase (Vercel, et .env.local en développement). Aucune valeur secrète ici.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Mettre 1 pour utiliser les émulateurs Firebase en local
VITE_FIREBASE_EMULATEURS=
