rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connecté avec un rôle donné par Marie (l'API) : un compte créé autrement n'a pas de rôle et n'a accès à rien.
    function connecte() {
      return request.auth != null && request.auth.token.get('role', '') in ['client', 'coach'];
    }
    function estCoach() {
      return connecte() && request.auth.token.role == 'coach';
    }
    function estClient() {
      return connecte() && request.auth.token.role == 'client';
    }
    function estMoi(uid) {
      return estClient() && request.auth.uid == uid;
    }

    // Profils : création et suppression uniquement par l'API (compte de service).
    match /utilisateurs/{uid} {
      allow read: if estMoi(uid) || estCoach();
      // Le client accepte l'accord santé une seule fois, sans toucher à rien d'autre.
      allow update: if estMoi(uid)
        && resource.data.accordSante == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accordSante', 'statut'])
        && request.resource.data.accordSante == request.time
        && request.resource.data.statut == 'actif';
      // Le client change sa photo de profil (chemin dans son dossier, ou null pour l'enlever), rien d'autre.
      allow update: if estMoi(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar'])
        && (request.resource.data.avatar == null
          || (request.resource.data.avatar is string
            && request.resource.data.avatar.matches('clients/' + uid + '/profil/[^/]+')));
      // Le coach modifie le profil (statut, nom…), jamais le rôle.
      allow update: if estCoach() && request.resource.data.role == resource.data.role;

      // Mesures du client : lecture, création, suppression par lui ou la coach ; pas de mise à jour.
      function mesureOuNull(champ) {
        return !(champ in request.resource.data) || request.resource.data[champ] == null || request.resource.data[champ] is number;
      }
      match /mesures/{id} {
        allow read, delete: if estMoi(uid) || estCoach();
        allow create: if (estMoi(uid) || estCoach())
          && request.resource.data.keys().hasOnly(['date', 'poids', 'taille', 'hanches', 'poitrine', 'bras', 'cuisse', 'creeLe'])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.creeLe == request.time
          && mesureOuNull('poids') && mesureOuNull('taille') && mesureOuNull('hanches')
          && mesureOuNull('poitrine') && mesureOuNull('bras') && mesureOuNull('cuisse');
      }
      // Photos de progression : le fichier doit être dans le dossier du client.
      match /photos/{id} {
        allow read, delete: if estMoi(uid) || estCoach();
        allow create: if (estMoi(uid) || estCoach())
          && request.resource.data.keys().hasOnly(['date', 'chemin', 'creeLe'])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.creeLe == request.time
          && request.resource.data.chemin is string
          && request.resource.data.chemin.matches('clients/' + uid + '/progression/[^/]+');
      }
      // Téléphones du coaché pour les notifications (19 novembre 2026) : il note le sien (l'identifiant est le jeton),
      // ou l'efface ; personne ne les lit dans l'application, seule l'API (compte de service) s'en sert.
      match /appareils/{jeton} {
        allow create, update: if estMoi(uid)
          && request.resource.data.keys().hasOnly(['jeton', 'creeLe', 'plateforme'])
          && request.resource.data.jeton == jeton
          && request.resource.data.creeLe == request.time
          && request.resource.data.plateforme in ['iphone', 'android', 'autre'];
        allow delete: if estMoi(uid);
      }
      // Bilans visio et notes privées : écrits et lus par le coach seulement ; le coaché ne les voit pas.
      match /bilans/{id} {
        allow read, write: if estCoach();
      }
      match /notesCoach/{id} {
        allow read, write: if estCoach();
      }
    }

    // Discussion entre la coach et chaque coaché (15 novembre 2026) : conversations/{uid du coaché}.
    // Fiche de la conversation : dernier message (pour la liste et les pastilles) et moments de lecture de chacun.
    // Chacun ne change que « son » moment de lecture et le dernier message signé de son rôle.
    function role() {
      return estCoach() ? 'coach' : 'client';
    }
    function dernierValide() {
      return !('dernier' in request.resource.data)
        || (request.resource.data.dernier.keys().hasOnly(['texte', 'auteur', 'le'])
          && request.resource.data.dernier.auteur == role()
          && request.resource.data.dernier.le == request.time
          && request.resource.data.dernier.texte is string
          && request.resource.data.dernier.texte.size() <= 200);
    }
    match /conversations/{uid} {
      allow read: if estMoi(uid) || estCoach();
      allow create: if (estMoi(uid) || estCoach())
        && request.resource.data.keys().hasOnly(['dernier', 'luCoach', 'luClient'])
        && dernierValide()
        && (estCoach() ? !('luClient' in request.resource.data) : !('luCoach' in request.resource.data));
      allow update: if (estMoi(uid) || estCoach())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(estCoach() ? ['dernier', 'luCoach'] : ['dernier', 'luClient'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dernier']) || dernierValide());
      allow delete: if false;

      // Messages : jamais modifiés ni effacés ; une photo jointe est dans le dossier du coaché.
      match /messages/{id} {
        allow read: if estMoi(uid) || estCoach();
        allow create: if (estMoi(uid) || estCoach())
          && request.resource.data.keys().hasOnly(['auteur', 'texte', 'piece', 'photo', 'envoyeLe'])
          && request.resource.data.auteur == role()
          && request.resource.data.envoyeLe == request.time
          && request.resource.data.texte is string
          && request.resource.data.texte.size() <= 2000
          && (request.resource.data.texte.size() > 0 || request.resource.data.get('piece', null) != null || request.resource.data.get('photo', null) != null)
          && (request.resource.data.get('piece', null) == null || request.resource.data.piece is map)
          && (request.resource.data.get('photo', null) == null
            || (request.resource.data.photo is string && request.resource.data.photo.matches('clients/' + uid + '/messages/[^/]+')));
        allow update, delete: if false;
      }
    }

    // Modèles de programmes réutilisables (page « Programmes » du coach)
    match /modeles/{id} {
      allow read, write: if estCoach();
    }

    // Listes réglables du coach (types de séance, catégories, matériels) : lues par tous les comptes, écrites par le coach
    match /reglages/{id} {
      allow read: if connecte();
      allow write: if estCoach();
    }

    match /exercices/{id} {
      allow read, write: if estCoach();
    }

    match /programmes/{id} {
      allow read: if estCoach()
        || (estClient() && resource.data.client == request.auth.uid && resource.data.statut == 'publié');
      allow write: if estCoach();
    }

    // Champs qu'un client peut écrire sur sa séance (jamais commentaireCoach ; client, programme, seance figés après création).
    function champsClient() {
      return ['client', 'programme', 'seance', 'date', 'statut', 'series', 'notes', 'blocs', 'effort', 'ressenti', 'commentaire', 'distance', 'temps', 'fc', 'zones', 'duree', 'majLe'];
    }

    match /seancesFaites/{id} {
      allow read: if estCoach() || (estClient() && resource.data.client == request.auth.uid);

      // Identifiant ${programme}_${seance} : une seule séance faite par séance, même si « Fin de séance » part deux fois.
      allow create: if estClient()
        && request.resource.data.client == request.auth.uid
        && id == request.resource.data.programme + '_' + request.resource.data.seance
        && request.resource.data.statut in ['en cours', 'terminée']
        && request.resource.data.keys().hasOnly(champsClient())
        && get(/databases/$(database)/documents/programmes/$(request.resource.data.programme)).data.client == request.auth.uid
        && get(/databases/$(database)/documents/programmes/$(request.resource.data.programme)).data.statut == 'publié';

      allow update: if
        // Le client modifie sa séance tant qu'elle est en cours.
        (estClient()
          && resource.data.client == request.auth.uid
          && resource.data.statut == 'en cours'
          && request.resource.data.client == resource.data.client
          && request.resource.data.programme == resource.data.programme
          && request.resource.data.seance == resource.data.seance
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(champsClient())
          && request.resource.data.statut in ['en cours', 'terminée'])
        // Le client corrige une séance déjà faite (16 novembre 2026) : ses notes seulement, la séance reste terminée à la même date.
        || (estClient()
          && resource.data.client == request.auth.uid
          && resource.data.statut == 'terminée'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['series', 'notes', 'blocs', 'distance', 'temps', 'fc', 'zones', 'duree']))
        // Le coach commente la séance (en cours ou terminée), rien d'autre.
        || (estCoach()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentaireCoach', 'majLe']));

      // Remettre à zéro une séance commencée par erreur (22 novembre 2026) : le coaché (la sienne) ou le coach ;
      // jamais une séance terminée.
      allow delete: if resource.data.statut == 'en cours'
        && (estCoach() || (estClient() && resource.data.client == request.auth.uid));
    }
  }
}
