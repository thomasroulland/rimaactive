rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connecté avec un rôle donné par Marie (l'API) : un compte créé autrement n'a pas de rôle et n'a accès à rien.
    function connecte() {
      return request.auth != null && request.auth.token.get('role', '') in ['client', 'coach'];
    }
    function estCoach() {
      return connecte() && request.auth.token.role == 'coach';
    }
    function estClient() {
      return connecte() && request.auth.token.role == 'client';
    }
    function estMoi(uid) {
      return estClient() && request.auth.uid == uid;
    }

    // Profils : création et suppression uniquement par l'API (compte de service).
    match /utilisateurs/{uid} {
      allow read: if estMoi(uid) || estCoach();
      // Le client accepte l'accord santé une seule fois, sans toucher à rien d'autre.
      allow update: if estMoi(uid)
        && resource.data.accordSante == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accordSante', 'statut'])
        && request.resource.data.accordSante == request.time
        && request.resource.data.statut == 'actif';
      // Le coach modifie le profil (statut, nom…), jamais le rôle.
      allow update: if estCoach() && request.resource.data.role == resource.data.role;
    }

    match /exercices/{id} {
      allow read, write: if estCoach();
    }

    match /programmes/{id} {
      allow read: if estCoach()
        || (estClient() && resource.data.client == request.auth.uid && resource.data.statut == 'publié');
      allow write: if estCoach();
    }

    // Champs qu'un client peut écrire sur sa séance (jamais commentaireCoach ; client, programme, seance figés après création).
    function champsClient() {
      return ['client', 'programme', 'seance', 'date', 'statut', 'series', 'effort', 'ressenti', 'douleur', 'distance', 'temps', 'majLe'];
    }

    match /seancesFaites/{id} {
      allow read: if estCoach() || (estClient() && resource.data.client == request.auth.uid);

      // Identifiant ${programme}_${seance} : une seule séance faite par séance, même si « Fin de séance » part deux fois.
      allow create: if estClient()
        && request.resource.data.client == request.auth.uid
        && id == request.resource.data.programme + '_' + request.resource.data.seance
        && request.resource.data.statut in ['en cours', 'terminée']
        && request.resource.data.keys().hasOnly(champsClient())
        && get(/databases/$(database)/documents/programmes/$(request.resource.data.programme)).data.client == request.auth.uid
        && get(/databases/$(database)/documents/programmes/$(request.resource.data.programme)).data.statut == 'publié';

      allow update: if
        // Le client modifie sa séance tant qu'elle est en cours.
        (estClient()
          && resource.data.client == request.auth.uid
          && resource.data.statut == 'en cours'
          && request.resource.data.client == resource.data.client
          && request.resource.data.programme == resource.data.programme
          && request.resource.data.seance == resource.data.seance
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(champsClient())
          && request.resource.data.statut in ['en cours', 'terminée'])
        // Le coach commente la séance (en cours ou terminée), rien d'autre.
        || (estCoach()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentaireCoach', 'majLe']));

      allow delete: if false;
    }
  }
}
